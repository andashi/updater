#!/usr/bin/env bash
# The owner's half of a release (docs/release.md, decision 0003): rebuild
# the tag locally, compare with what two CI runners built, sign CI's
# artifact offline, print the fingerprint. Every step that cannot be
# verified refuses.
#
#   bin/release-sign <tag> <keystore.p12> [alias]
#
# Needs: git, gh, sha256sum, apksigner (build-tools), the pinned JDK.
set -euo pipefail
tag="${1:?usage: bin/release-sign <tag> <keystore> [alias]}"
keystore="${2:?keystore path}"
alias="${3:-updater}"
REPO="${RELEASE_REPO:-andashi/updater}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bt="$(ls -d "${ANDROID_HOME:-/opt/android-sdk}"/build-tools/* | sort -V | tail -1)"
ok(){ printf '  + %s\n' "$*"; }; bad(){ printf '  x %s\n' "$*" >&2; exit 1; }

cd "$ROOT"
git fetch -q origin --tags
[ "$(git rev-parse "$tag^{commit}")" = "$(git merge-base "$tag" origin/main)" ] || bad "$tag is not on origin/main"
git -c advice.detachedHead=false checkout -q "$tag"
ok "checked out $tag ($(git rev-parse --short HEAD))"

work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
gh release download "$tag" --repo "$REPO" --dir "$work" --pattern 'updater-unsigned.apk' --pattern 'SHA256SUMS' \
  || bad "no draft release $tag with the unsigned artifact - has CI finished?"
ci="$(cut -d' ' -f1 "$work/SHA256SUMS")"
[ "$(sha256sum "$work/updater-unsigned.apk" | cut -d' ' -f1)" = "$ci" ] || bad "the downloaded artifact does not match CI's own SHA256SUMS"
ok "CI artifact $ci"

./gradlew --no-daemon -q :app:assembleRelease
local_sha="$(sha256sum app/build/outputs/apk/release/app-release-unsigned.apk | cut -d' ' -f1)"
[ "$local_sha" = "$ci" ] || bad "local build $local_sha differs from CI's $ci - not reproducible here, no release"
ok "local build matches CI byte for byte"

# Sign CI's artifact, not the local build: what ships is what was compared.
out="$ROOT/updater-$tag.apk"
"$bt/apksigner" sign --ks "$keystore" --ks-key-alias "$alias" --v2-signing-enabled true --v3-signing-enabled true \
  --out "$out" "$work/updater-unsigned.apk"
"$bt/apksigner" verify --print-certs "$out" > "$work/certs.txt"
fp="$(sed -n 's/.*SHA-256 digest: //p' "$work/certs.txt" | head -1 | tr 'A-F' 'a-f')"
pin="$(sed -n 's/^.*fingerprint[^0-9a-f]*\([0-9a-f]\{64\}\).*$/\1/p' README.md | head -1)"
if [ -n "$pin" ]; then
  [ "$fp" = "$pin" ] || bad "signed with $fp, but the README pins $pin"
  ok "signer matches the README's pin"
else
  echo "  ! README carries no pin yet - this is the first release; record this fingerprint:"
fi
printf '  signer sha256: %s\n  signed apk:    %s\n  next:          gh release upload %s %s --repo %s && gh release edit %s --draft=false --repo %s\n' \
  "$fp" "$out" "$tag" "$out" "$REPO" "$tag" "$REPO"
