<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext, and only the system's certificate store: a user-added CA
     may not speak for the lock's host (design §10). The debug build adds a
     localhost exception for the emulator e2e in src/debug; the release
     build carries none. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
